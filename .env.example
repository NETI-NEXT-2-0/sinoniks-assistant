# Generate private values: python3 scripts/bootstrap-env.py
# Never use this file itself as a credentials source.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
HATCHET_DB_PASSWORD=
PHOENIX_DB_PASSWORD=
PARTNER_DATABASE_URL=
PARTNER_ENVIRONMENT=development
PARTNER_PUBLIC_ORIGIN=http://localhost:8080
HATCHET_DATABASE_URL=
HATCHET_ADMIN_EMAIL=operator@partner.local
HATCHET_ADMIN_PASSWORD=
GARAGE_DEFAULT_ACCESS_KEY=
GARAGE_DEFAULT_SECRET_KEY=
GARAGE_DEFAULT_BUCKET=originals
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ORIGINALS_BUCKET=originals
S3_DERIVED_BUCKET=derived
# Production: domain name + PARTNER_ENVIRONMENT=production + https public origin.
CADDY_ADDRESS=:80

# Local observability profile (unique random values from bootstrap-env.py)
GRAFANA_ADMIN_PASSWORD=
PHOENIX_SECRET=
PHOENIX_ADMIN_PASSWORD=
PHOENIX_SQL_DATABASE_URL=

# Stage2: python3 scripts/bootstrap-hatchet.py generates a local token without printing it.
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_SERVER_URL=http://hatchet-dashboard:80
HATCHET_CLIENT_HOST_PORT=hatchet-engine:7070
HATCHET_CLIENT_TLS_STRATEGY=none
PARTNER_RUNTIME_AUTOMATIC_TAKEOVER=false
PARTNER_RUNTIME_GRAPH_VERSION=fixture-v1
PARTNER_RUNTIME_LEASE_SECONDS=30
PARTNER_RUNTIME_HEARTBEAT_SECONDS=10

# Optional model tariffs in USD per million tokens. A zero cap disables that limit.
PARTNER_MODEL_MAX_OUTPUT_TOKENS=3000
PARTNER_MODEL_INPUT_USD_PER_MILLION=0
PARTNER_MODEL_OUTPUT_USD_PER_MILLION=0
PARTNER_MODEL_REQUEST_CAP_USD=0
PARTNER_MODEL_DAILY_CAP_USD=0

# Optional public discovery through our private SearXNG service (profile web).
SEARXNG_SECRET=
PARTNER_SEARXNG_URL=
PARTNER_WEB_OFFICIAL_DOMAINS=
