{$CADDY_ADDRESS} {
    handle /api/* {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }
    handle /health/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
}
